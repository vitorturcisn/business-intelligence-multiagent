# Modelo local — Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# LangSmith — deixe a chave vazia no arquivo de exemplo
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-intelligence-multiagent

# Compatibilidade / configuração existente
DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true

# PostgreSQL — LangGraph checkpointer e advisory lock do CLI multiagente
# Substitua os valores pelo endpoint do seu PostgreSQL.
POSTGRES_CHECKPOINTER_URI=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase PGVector semantic retrieval backend (configurable)
SUPABASE_URL=
SUPABASE_KEY=

# Optional: alternate SQLite path for benchmark/test sessions.
# Empty or unset keeps data/sample/sales.db.
BI_MULTIAGENT_DATABASE_PATH=

# Supabase PGVector (configure apenas no .env local; nunca versione credenciais)
SUPABASE_DB_URI=
SUPABASE_SSLMODE=require
SUPABASE_VECTOR_SCHEMA=public
SUPABASE_VECTOR_TABLE=business_knowledge_vectors
SUPABASE_VECTOR_SIZE=384
KNOWLEDGE_VECTOR_BACKEND=faiss
LANGSMITH_WORKSPACE_ID=
