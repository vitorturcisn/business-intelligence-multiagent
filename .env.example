# Modelo local — Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# LangSmith — deixe a chave vazia no arquivo de exemplo
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=business-intelligence-multiagent

# Compatibilidade / configuração existente
DATABASE_URL=
LANGGRAPH_STRICT_MSGPACK=true

# PostgreSQL — LangGraph checkpointer e advisory lock do CLI multiagente
# Substitua os valores pelo endpoint do seu PostgreSQL.
POSTGRES_CHECKPOINTER_URI=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Supabase — reservado para a implementação de PGVector (ainda não ativo no runtime atual)
SUPABASE_URL=
SUPABASE_KEY=
